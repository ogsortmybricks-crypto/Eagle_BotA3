#!/usr/bin/env bash
# Local Tac-On sandbox: a real Eagle Bot server on its own throwaway database.
#
#   testing/sandbox up        start (or restart) the database, server and seed data
#   testing/sandbox down      stop the server (the database container keeps running)
#   testing/sandbox status    is it up, and where
#   testing/sandbox reset     wipe the sandbox academy (every Tac-On, install, record) and re-seed
#   testing/sandbox seed      re-seed personas without wiping anything
#   testing/sandbox fire <event> [--studio launchpad|middle|none] [--actor <persona>] [--winner <persona>] [--votes N] [--summary "..."] [--entity N] [--metadata '<json>']
#   testing/sandbox records <slug>   dump stored records for a Tac-On's sandbox installs
#   testing/sandbox logs      tail the server log
#
# Settings come from testing/sandbox.env (see sandbox.env.example).
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
[ -f "$here/sandbox.env" ] && set -a && . "$here/sandbox.env" && set +a

ENGINE="${EAGLE_BOT_ENGINE:-$(cd "$here/../.." && pwd)}"
PORT="${SANDBOX_PORT:-5199}"
PG_CONTAINER="${SANDBOX_PG_CONTAINER:-eagle-pg}"
PG_USER="${SANDBOX_PG_USER:-eagle}"
PG_PASSWORD="${SANDBOX_PG_PASSWORD:-eagle}"
PG_PORT="${SANDBOX_PG_PORT:-55432}"
DB_NAME="${SANDBOX_DB:-eagle_sandbox}"
DATABASE_URL="postgresql://$PG_USER:$PG_PASSWORD@localhost:$PG_PORT/$DB_NAME"
OUT="$here/out"
PIDFILE="$OUT/server.pid"
LOG="$OUT/server.log"
mkdir -p "$OUT"

if [ ! -f "$ENGINE/shared/tacons/compile.ts" ]; then
  echo "EAGLE_BOT_ENGINE ($ENGINE) isn't an Eagle Bot checkout. Set it in testing/sandbox.env." >&2
  exit 1
fi
export EAGLE_BOT_ENGINE="$ENGINE" DATABASE_URL

engine_tsx() {
  # Run from the engine so its tsconfig paths (@shared/*) and node_modules resolve.
  (cd "$ENGINE" && TSX_TSCONFIG_PATH="$ENGINE/tsconfig.json" npx tsx $(stub_flag) "$@")
}
stub_flag() {
  # Some checkouts are missing pdf-parse (and can't npm install it). The Tac-On
  # sandbox never parses PDFs, so stub it rather than refuse to start.
  [ -d "$ENGINE/node_modules/pdf-parse" ] || echo "--import $here/stubs/register.mjs"
}
running() { [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; }

start_db() {
  if docker inspect "$PG_CONTAINER" >/dev/null 2>&1; then
    if [ "$(docker inspect -f '{{.State.Running}}' "$PG_CONTAINER")" != "true" ] && ! docker start "$PG_CONTAINER" >/dev/null 2>"$OUT/docker.log"; then
      if grep -q "already exists" "$OUT/docker.log"; then
        # After a host restart Docker can keep a dead runtime entry for the container.
        # Clearing it touches no data; the database volume is untouched.
        sudo runc --root /run/docker/runtime-runc/moby delete --force "$(docker inspect -f '{{.Id}}' "$PG_CONTAINER")" 2>/dev/null || true
        docker start "$PG_CONTAINER" >/dev/null
      else cat "$OUT/docker.log" >&2; exit 1; fi
    fi
    for _ in $(seq 1 30); do docker exec "$PG_CONTAINER" pg_isready -U "$PG_USER" >/dev/null 2>&1 && break; sleep 1; done
    if ! docker exec "$PG_CONTAINER" psql -U "$PG_USER" -d postgres -tAc "select 1 from pg_database where datname='$DB_NAME'" | grep -q 1; then
      docker exec "$PG_CONTAINER" psql -U "$PG_USER" -d postgres -c "create database $DB_NAME" >/dev/null
      echo "Created database $DB_NAME."
    fi
  else
    echo "No docker container \"$PG_CONTAINER\". Create one with:" >&2
    echo "  docker run -d --name $PG_CONTAINER -e POSTGRES_USER=$PG_USER -e POSTGRES_PASSWORD=$PG_PASSWORD -p $PG_PORT:5432 postgres:16-alpine" >&2
    exit 1
  fi
}

push_schema() {
  (cd "$ENGINE" && npm run --silent tacons:generate && npx drizzle-kit push --force >"$OUT/db-push.log" 2>&1) || { cat "$OUT/db-push.log" >&2; exit 1; }
  # A non-interactive push can exit 0 without applying anything; check the tables are really there.
  if ! docker exec "$PG_CONTAINER" psql -U "$PG_USER" -d "$DB_NAME" -tAc "select to_regclass('public.tacon_installs')" | grep -q tacon_installs; then
    echo "Schema push didn't create the Tac-On tables. See $OUT/db-push.log." >&2
    exit 1
  fi
}

stop_server() {
  if running; then
    # The server runs in its own process group (setsid), so this stops npx, tsx and node together.
    kill -TERM -- "-$(cat "$PIDFILE")" 2>/dev/null || kill "$(cat "$PIDFILE")" 2>/dev/null || true
    for _ in $(seq 1 20); do running || break; sleep 0.5; done
  fi
  rm -f "$PIDFILE"
}

start_server() {
  stop_server
  : >"$LOG"
  (cd "$ENGINE" && exec env NODE_ENV=development PORT="$PORT" APP_URL="http://localhost:$PORT" DATABASE_URL="$DATABASE_URL" \
    TSX_TSCONFIG_PATH="$ENGINE/tsconfig.json" setsid npx tsx $(stub_flag) server/index.ts >>"$LOG" 2>&1 </dev/null) &
  echo $! >"$PIDFILE"
  for _ in $(seq 1 60); do
    curl -fs "http://localhost:$PORT/api/health" >/dev/null 2>&1 && return 0
    running || { echo "The server exited. Last lines of $LOG:" >&2; tail -n 30 "$LOG" >&2; exit 1; }
    sleep 1
  done
  echo "The server didn't answer on port $PORT. See $LOG." >&2
  exit 1
}

command="${1:-help}"; shift || true
case "$command" in
  up)
    start_db
    push_schema
    start_server
    engine_tsx "$here/sandbox-db.ts" seed
    echo "Sandbox is up at http://localhost:$PORT (engine: $ENGINE, commit $(git -C "$ENGINE" rev-parse --short HEAD 2>/dev/null || echo unknown))."
    ;;
  down) stop_server; echo "Sandbox server stopped." ;;
  status)
    if running && curl -fs "http://localhost:$PORT/api/health" >/dev/null 2>&1; then
      echo "Up at http://localhost:$PORT (pid $(cat "$PIDFILE"), engine $ENGINE)."
    else echo "Down. Start it with: testing/sandbox up"; fi
    ;;
  seed|reset|fire|records) start_db; engine_tsx "$here/sandbox-db.ts" "$command" "$@" ;;
  logs) tail -n "${1:-80}" "$LOG" ;;
  *) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
