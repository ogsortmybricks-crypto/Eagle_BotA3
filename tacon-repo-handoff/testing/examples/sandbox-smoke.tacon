# Smoke test for the sandbox: one of nearly everything TacScript has.
# Run: node testing/tacon-test.mjs try testing/examples/sandbox-smoke.tacon --hold treasurer=learner1
tacon sandbox-smoke {
  name "Sandbox Smoke"
  version 1.0.0
  about "Checks that the Tac-On sandbox is wired up."
  icon coins
  category tracking

  setting election_award {
    label "Points for winning an election"
    type number
    default 10
  }

  store entry {
    field hero person required
    field amount number
    field reason text
  }

  ask balance sum of entry.amount where entry.hero is me.id

  page ledger {
    title "Smoke Ledger"
    nav true
    note "You're holding {my.balance} points. The Treasurer is {position.treasurer}."
    stat "In circulation" sum of entry.amount

    form "Log points" {
      into entry
      ask hero
      ask amount
      ask reason
      allow admin, treasurer
    }

    list entry {
      columns hero, amount, reason, by
      sort newest
      allow remove admin
    }
  }

  page staff {
    title "Staff only"
    nav true
    show to admin, guide
    note "Only admins and guides can open this page."
  }

  panel on town-hall {
    title "Points this term"
    stat "Logged" count of entry
  }

  position treasurer {
    title "Treasurer"
    seats 1
    appointed
    note "Your desk: {my.balance} points are yours."
  }

  when election.certified {
    only if event.winner above 0
    add entry {
      hero: event.winner
      amount: setting.election_award
      reason: "Elected"
    }
    notify "Awarded points for a certified election."
  }
}
