# Copy to testing/sandbox.env (gitignored) and adjust.

# The Eagle Bot checkout. Defaults to two folders up from testing/ (right while
# this lives inside the Eagle Bot repo). Set it when this is its own repo.
# EAGLE_BOT_ENGINE=/workspaces/Eagle_BotA3

SANDBOX_PORT=5199
SANDBOX_PASSWORD=sandbox-password

# Local Postgres in Docker. The database name must contain "sandbox".
SANDBOX_PG_CONTAINER=eagle-pg
SANDBOX_PG_USER=eagle
SANDBOX_PG_PASSWORD=eagle
SANDBOX_PG_PORT=55432
SANDBOX_DB=eagle_sandbox

# Only for `tacon-test.mjs check --live` (compile-only, saves nothing).
# Use a dev portal account, or an academy account with dev status.
# LIVE_URL=https://your-eagle-bot.example
# LIVE_PORTAL_EMAIL=
# LIVE_PORTAL_PASSWORD=
# LIVE_EMAIL=
# LIVE_PASSWORD=
