# Requires Eagle Bot's transaction-backed market extension.
# 100 points = 1 Eagle Buck; each learner may hold at most 1,000 points.
tacon eagle-buck-market {
  name "Eagle Buck Market"
  version 1.1.0
  about "Track where points came from, spend Eagle Bucks, and give the Shopkeeper an accountable purchase log."
  icon coins
  category tracking

  market wallet {
    title "Eagle Buck Market"
    rate 100
    cap 1000
    keeper shopkeeper
    scope academy
    overdraft true
  }

  page market {
    title "Eagle Buck Market"
    icon coins
    nav true
    subtitle "Earn points, record their source, and shop with Eagle Bucks. Spending can go below zero; future earnings repay the balance."
    note "100 points make 1 Eagle Buck. You may hold up to 10 Eagle Bucks (1,000 points)." info
    note "With overdraft enabled, spending can take your balance below zero; future earnings repay it. The 10 Eagle Buck upper cap is unchanged." info
    market wallet
  }

  position shopkeeper {
    title "Shopkeeper"
    about "Fulfills marketplace purchases and keeps the Eagle Buck ledger accountable."
    seats 1
    elected true
    term "One session"
    duties "Review the points ledger and its sources", "Read the purchase log and deliver purchases", "Mark delivered purchases fulfilled"
    note "This desk belongs to whoever currently holds the Shopkeeper position."
    market wallet
  }
}