{
  "name": "eagle-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx watch server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/index.js",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@tanstack/react-query": "^5.102.8",
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^10.0.0",
    "date-fns": "^4.4.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.38.4",
    "drizzle-zod": "^0.6.1",
    "express": "^4.22.3",
    "express-session": "^1.19.0",
    "lucide-react": "^0.469.0",
    "mammoth": "^1.12.3",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.1.16",
    "nodemailer": "^6.10.1",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "wouter": "^3.11.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/connect-pg-simple": "^7.0.3",
