    "@types/express-session": "^1.19.0",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.20.2",
    "@types/nodemailer": "^6.4.24",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "drizzle-kit": "^0.30.6",
    "esbuild": "^0.24.2",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  }
