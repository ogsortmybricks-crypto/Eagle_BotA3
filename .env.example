# ---- Database (Replit: add a Postgres database and this is set for you) ----
DATABASE_URL=postgresql://user:password@host:5432/eagle_bot

# ---- Session ----
# Any long random string. Rotating it logs everybody out.
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Dev portal (Ctrl+D) ----
# Claims the head dev account, once. Required in production.
DEV_PORTAL_SETUP_KEY=

# ---- Claude API ----
ANTHROPIC_API_KEY=place-your-anthropic-api-key-here

# ---- Email (Gmail + App Password) ----
# Create at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=smtp@emailaddress.com
SMTP_PASS=your-app-password
SMTP_FROM="Eagle Bot <smtp@emailaddress.com>"

# ---- App ----
# Public base URL, used to build invite links in emails.
APP_URL=http://localhost:5000
PORT=5000
